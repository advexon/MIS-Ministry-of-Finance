# Supabase Configuration
NEXT_PUBLIC_MISSUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_MISSUPABASE_ANON_KEY=your-anon-key

# Alias variables (can be used instead of MISSUPABASE)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key for administrator account creation and password resets
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# No SMTP or external email service is required. Notifications are delivered in-app.

# Error Monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# App Configuration
NEXT_PUBLIC_APP_VERSION=1.0.0
NODE_ENV=development
